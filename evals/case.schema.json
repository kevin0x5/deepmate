{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://deepmate.local/evals/case.schema.json",
  "title": "Deepmate evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "version",
    "suite",
    "kind",
    "title",
    "okr",
    "environment",
    "agent",
    "permissions",
    "conversation",
    "budgets",
    "graders",
    "hard_failures",
    "metrics"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "id": {"type": "string", "pattern": "^dm-[a-z0-9]+(?:-[a-z0-9]+)+-[0-9]{3}$"},
    "version": {"type": "integer", "minimum": 1},
    "suite": {"enum": ["context", "long-task", "tool-governance", "evolution", "local-model", "security"]},
    "kind": {"enum": ["capability", "regression", "safety"]},
    "title": {"type": "string", "minLength": 8},
    "okr": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objective", "key_results"],
      "properties": {
        "objective": {"enum": ["O1", "O2", "O3", "O4"]},
        "key_results": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"pattern": "^KR[1-4]\\.[1-3]$", "type": "string"}
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["class", "modes"],
      "properties": {
        "class": {"enum": ["deterministic-runtime", "product-capability"]},
        "modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["offline", "online", "local"]}
        }
      }
    },
    "environment": {"type": "object"},
    "agent": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 64},
        "responses": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "content": {"type": "string"},
              "finish_reason": {"type": "string"},
              "usage": {"type": "object"},
              "tool_calls": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["name"],
                  "properties": {
                    "name": {"type": "string", "minLength": 1},
                    "id": {"type": "string"},
                    "arguments": {"type": "object"},
                    "raw_arguments": {"type": "string"},
                    "argument_error": {"type": "string"}
                  }
                }
              }
            }
          }
        }
      }
    },
    "permissions": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["read_only", "workspace_write"]},
        "approve": {"type": "boolean"}
      }
    },
    "conversation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "content"],
        "properties": {
          "role": {"enum": ["user", "assistant"]},
          "content": {"type": "string", "minLength": 1}
        }
      }
    },
    "budgets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_steps": {"type": "integer", "minimum": 1, "maximum": 64},
        "provider_attempts": {"type": "integer", "minimum": 1, "maximum": 5}
      }
    },
    "graders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"type": "string", "minLength": 1}}
      }
    },
    "hard_failures": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {"type": {"type": "string", "minLength": 1}}
      }
    },
    "metrics": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true},
    "presets": {"type": "array", "items": {"enum": ["pr", "nightly", "release", "core"]}, "uniqueItems": true},
    "tags": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
  }
}
